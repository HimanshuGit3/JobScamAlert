# Copy to .env (never commit .env). All keys are optional: missing keys
# disable that check and the scan still runs on deterministic checks.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any current Gemini Flash model ID
GEMINI_MODEL=gemini-3.8-flash
# Tried once if the main model is overloaded or unavailable ("none" disables)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# Google Safe Browsing API v4 key (Google Cloud console > APIs & Services)
SAFE_BROWSING_API_KEY=

# Max scans per client IP per minute (in-memory, per instance)
RATE_LIMIT_PER_MINUTE=10
# Number of trusted reverse proxies in front of the app. 0 = ignore
# X-Forwarded-For and use the TCP peer. See README for Cloud Run.
TRUSTED_PROXY_COUNT=0
# Download the linked page (SSRF-protected) and analyse its text too
FETCH_LINKED_PAGES=true
